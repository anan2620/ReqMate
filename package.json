{
  "name": "reqmate",
  "private": true,
  "version": "1.1.5",
  "description": "Local-first API development platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/anan2620/ReqMate"
  },
  "homepage": "https://github.com/anan2620/ReqMate",
  "bugs": {
    "url": "https://github.com/anan2620/ReqMate/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @reqmate/desktop dev",
    "dev:web": "pnpm --filter @reqmate/web dev",
    "build": "pnpm --filter @reqmate/desktop build",
    "build:web": "pnpm --filter @reqmate/web build",
    "tauri": "pnpm --filter @reqmate/desktop tauri",
    "lint": "pnpm --filter @reqmate/desktop lint",
    "check:versions": "node scripts/check-versions.mjs",
    "check:models": "node scripts/check-model-drift.mjs",
    "preview": "pnpm --filter @reqmate/desktop preview",
    "start:web": "pnpm --filter @reqmate/web start"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
